{
  "env": {
    "MISE_AUTO_INSTALL": "false"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:agents.md)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:www.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:docs.codeium.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:www.windmill.dev)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:neon.com)",
      "Read(//c/Users/ec/.claude/skills/prompt-review/**)",
      "Read(C:/Users/ec/.claude/skills/prompt-review/**)",
      "Read(//c/Users/ec/System/Dotfiles/claude/skills/prompt-review/**)",
      "Read(C:/Users/ec/System/Dotfiles/claude/skills/prompt-review/**)",
      "Bash(ds-review *)",
      "Bash(C:/Users/ec/.claude/bin/ds-review *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/git-deny.mjs\"",
            "if": "Bash(*git*)"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/git-deny.mjs\"; exit $LASTEXITCODE",
            "shell": "powershell"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "boostvolt/claude-code-lsps"
      }
    }
  },
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "10m",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": false,
  "precomputeCompactionEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  }
}
