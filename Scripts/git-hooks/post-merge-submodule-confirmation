#!/bin/bash

# Original source:
#    <https://github.com/chaitanyagupta/gitutils/blob/master/submodule-hooks/post-merge-checkout>

# After a merge (or pull) or branch checkout that moved any submodule's recorded commit, offer to
# update just those; submodules deliberately checked out elsewhere aren't touched.

case "$(basename "$0")" in
    post-checkout*)
        # A file checkout, or HEAD didn't move
        [[ "$3" = 0 || "$1" = "$2" ]] && exit 0
        from=$1 to=$2 ;;
    *)  from=ORIG_HEAD to=HEAD ;;
esac

moved=$(git diff --raw --no-renames "$from" "$to" 2>/dev/null | awk -F'\t' '$1 ~ / 160000 / { print $2 }')
[[ -z "$moved" ]] && exit 0

echo "The following submodules have been updated in HEAD:"
echo "$moved"
echo -n "Update them? [y/N] "
if ! read -r -n 1 reply 2>/dev/null </dev/tty; then
    echo
    echo "(No terminal. To update: git submodule update --init --" $moved ")"
    exit 0
fi
echo
if [[ "$reply" == "y" || "$reply" == "Y" ]]; then
    IFS=$'\n'
    git submodule update --init -- $moved
fi
