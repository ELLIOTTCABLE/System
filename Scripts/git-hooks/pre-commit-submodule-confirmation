#!/bin/bash

# Original source:
#    <https://github.com/chaitanyagupta/gitutils/blob/master/submodule-hooks/pre-commit>

# Ask for confirmation before committing a change to any submodule's recorded commit.

staged=$(git diff --cached --raw --no-renames | awk -F'\t' '$1 ~ /(^:| )160000 / { print $2 }')
[[ -z "$staged" ]] && exit 0

echo "The following modified submodules are about to be committed:"
echo "$staged"
echo -n "Continue with commit? [n] "
if ! read -r -n 1 reply 2>/dev/null </dev/tty; then
    echo
    echo "Aborted commit: no terminal to confirm on."
    exit 1
fi
echo
[[ "$reply" == "y" || "$reply" == "Y" ]] && exit 0
echo "Aborted commit."
exit 1
